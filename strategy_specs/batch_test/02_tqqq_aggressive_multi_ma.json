{
  "name": "TQQQ Aggressive Multi-MA Alignment",
  "description": "Full position in TQQQ when all MAs are perfectly aligned. Exit on SMA10 break.",
  "symbols": ["TQQQ"],
  "indicators": [
    {"type": "ema", "length": 3, "source": "close", "name": "ema_3"},
    {"type": "sma", "length": 10, "source": "close", "name": "sma_10"},
    {"type": "sma", "length": 20, "source": "close", "name": "sma_20"},
    {"type": "sma", "length": 50, "source": "close", "name": "sma_50"},
    {"type": "external", "symbol": "QQQ", "field": "close", "name": "qqq_close"},
    {"type": "sma", "length": 50, "source": "qqq_close", "name": "qqq_sma_50"},
    {"type": "sma", "length": 200, "source": "qqq_close", "name": "qqq_sma_200"},
    {"type": "custom", "name": "momentum", "formula": "close / sma_50"}
  ],
  "entry_rule_long": "ema_3 > sma_10 & sma_10 > sma_20 & sma_20 > sma_50 & qqq_close > qqq_sma_50 & qqq_sma_50 > qqq_sma_200",
  "exit_rule": "close < sma_10",
  "entry_price_field": "close",
  "ranking_field": "momentum",
  "position_size_mode": "notional_pct",
  "position_size_pct": 100.0,
  "max_positions": 1,
  "stop_loss_pct": 0.0,
  "max_holding_days": 0
}
