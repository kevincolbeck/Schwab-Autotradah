{
  "name": "TQQQ Trend Following (QQQ Technicals)",
  "description": "Ride TQQQ when QQQ is in a confirmed uptrend. 100% allocation, SMA10 exit.",
  "symbols": ["TQQQ"],
  "indicators": [
    {"type": "external", "symbol": "QQQ", "field": "close", "name": "qqq_close"},
    {"type": "ema", "length": 21, "source": "qqq_close", "name": "qqq_ema_21"},
    {"type": "sma", "length": 50, "source": "qqq_close", "name": "qqq_sma_50"},
    {"type": "sma", "length": 200, "source": "qqq_close", "name": "qqq_sma_200"},
    {"type": "sma", "length": 10, "source": "close", "name": "sma_10"},
    {"type": "rsi", "length": 14, "source": "qqq_close", "name": "qqq_rsi"}
  ],
  "entry_rule_long": "qqq_close > qqq_ema_21 & qqq_ema_21 > qqq_sma_50 & qqq_sma_50 > qqq_sma_200 & qqq_rsi > 40 & qqq_rsi < 75",
  "exit_rule": "close < sma_10",
  "entry_price_field": "close",
  "position_size_mode": "notional_pct",
  "position_size_pct": 100.0,
  "max_positions": 1,
  "stop_loss_pct": 8.0,
  "max_holding_days": 0
}
