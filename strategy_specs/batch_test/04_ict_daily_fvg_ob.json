{
  "name": "ICT Daily FVG + Order Block (Tech Stocks)",
  "description": "Daily ICT concepts: bullish FVG and order block reclaim on large cap tech with HTF trend alignment.",
  "symbols": ["NVDA", "TSLA", "MSFT", "AAPL", "META", "GOOGL", "AMZN", "AMD"],
  "indicators": [
    {"type": "external", "symbol": "SPY", "field": "close", "name": "spy_close"},
    {"type": "sma", "length": 200, "source": "close", "name": "sma_200"},
    {"type": "sma", "length": 50, "source": "close", "name": "sma_50"},
    {"type": "ema", "length": 21, "source": "close", "name": "ema_21"},
    {"type": "atr", "length": 14, "name": "atr_14"},
    {"type": "sma", "length": 20, "source": "volume", "name": "vol_sma_20"},
    {"type": "sma", "length": 50, "source": "spy_close", "name": "spy_sma_50"},
    {"type": "rolling_max", "length": 20, "source": "high", "name": "high_20"},
    {"type": "custom", "name": "fvg_bull", "formula": "(low > lag(high, 2)) & ((low - lag(high, 2)) / atr_14 >= 0.1)"},
    {"type": "custom", "name": "ob_reclaim", "formula": "(lag(close, 1) < lag(open, 1)) & (low <= lag(high, 1)) & (close >= lag(open, 1))"},
    {"type": "custom", "name": "stop_dist", "formula": "atr_14 * 1.5"}
  ],
  "entry_rule_long": "close > sma_200 & sma_50 > sma_200 & ema_21 > sma_50 & spy_close > spy_sma_50 & volume >= vol_sma_20 * 1.3 & (fvg_bull | ob_reclaim)",
  "exit_rule": "close < ema_21",
  "entry_price_field": "close",
  "position_size_mode": "risk_pct",
  "risk_per_trade_pct": 2.0,
  "max_positions": 5,
  "stop_loss_field": "stop_dist",
  "take_profit_rules": [
    {"trigger_r": 2.0, "action": "sell_partial", "sell_pct_of_position": 50.0, "move_stop_to_pct": 0.0}
  ],
  "max_holding_days": 0
}
