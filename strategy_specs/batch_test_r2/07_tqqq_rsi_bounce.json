{
  "name": "R2: TQQQ RSI Bounce Trader",
  "description": "Buy TQQQ on RSI2 extremes in bull market. Very short-term mean reversion with quick exits.",
  "symbols": ["TQQQ"],
  "indicators": [
    {"type": "external", "symbol": "QQQ", "field": "close", "name": "qqq_close"},
    {"type": "sma", "length": 200, "source": "qqq_close", "name": "qqq_sma_200"},
    {"type": "rsi", "length": 2, "source": "close", "name": "rsi_2"},
    {"type": "rsi", "length": 2, "source": "qqq_close", "name": "qqq_rsi_2"},
    {"type": "sma", "length": 5, "source": "close", "name": "sma_5"}
  ],
  "entry_rule_long": "qqq_close > qqq_sma_200 & qqq_rsi_2 < 10",
  "exit_rule": "rsi_2 > 90 | close > sma_5",
  "entry_price_field": "close",
  "position_size_mode": "notional_pct",
  "position_size_pct": 100.0,
  "max_positions": 1,
  "stop_loss_pct": 8.0,
  "max_holding_days": 5
}
