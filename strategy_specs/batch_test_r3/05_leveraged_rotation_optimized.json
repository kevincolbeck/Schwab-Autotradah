{
  "name": "R3: Leveraged ETF Rotation (Best from R2 optimized)",
  "description": "Rotate into best momentum 3x ETF. Widened exit to SMA50. Added more ETF options.",
  "symbols": ["TQQQ", "SOXL", "TECL", "UPRO", "LABU", "TNA"],
  "indicators": [
    {"type": "ema", "length": 21, "source": "close", "name": "ema_21"},
    {"type": "sma", "length": 50, "source": "close", "name": "sma_50"},
    {"type": "sma", "length": 100, "source": "close", "name": "sma_100"},
    {"type": "sma", "length": 200, "source": "close", "name": "sma_200"},
    {"type": "external", "symbol": "SPY", "field": "close", "name": "spy_close"},
    {"type": "sma", "length": 200, "source": "spy_close", "name": "spy_sma_200"},
    {"type": "custom", "name": "momentum", "formula": "close / sma_100"}
  ],
  "entry_rule_long": "close > ema_21 & ema_21 > sma_50 & spy_close > spy_sma_200",
  "exit_rule": "close < sma_50",
  "entry_price_field": "close",
  "ranking_field": "momentum",
  "position_size_mode": "notional_pct",
  "position_size_pct": 100.0,
  "max_positions": 1,
  "stop_loss_pct": 0.0,
  "max_holding_days": 0
}
