{
  "name": "R3: Volatility Breakout (Tight Range Expansion)",
  "description": "Buy when price breaks above 20-day high after tight consolidation (low ATR/close ratio). Volume confirmation. Pure technical.",
  "symbols": ["NVDA", "TSLA", "MSFT", "AAPL", "META", "GOOGL", "AMZN", "AMD"],
  "indicators": [
    {"type": "sma", "length": 50, "source": "close", "name": "sma_50"},
    {"type": "sma", "length": 200, "source": "close", "name": "sma_200"},
    {"type": "ema", "length": 21, "source": "close", "name": "ema_21"},
    {"type": "atr", "length": 14, "name": "atr_14"},
    {"type": "rolling_max", "length": 20, "source": "high", "name": "high_20"},
    {"type": "sma", "length": 20, "source": "volume", "name": "vol_sma_20"},
    {"type": "external", "symbol": "SPY", "field": "close", "name": "spy_close"},
    {"type": "sma", "length": 200, "source": "spy_close", "name": "spy_sma_200"},
    {"type": "custom", "name": "vol_ratio", "formula": "atr_14 / close"},
    {"type": "custom", "name": "momentum", "formula": "close / sma_50"}
  ],
  "entry_rule_long": "close > sma_200 & sma_50 > sma_200 & spy_close > spy_sma_200 & high >= high_20 & volume >= vol_sma_20 * 1.3 & vol_ratio < 0.03",
  "exit_rule": "close < ema_21",
  "entry_price_field": "close",
  "ranking_field": "momentum",
  "position_size_mode": "notional_pct",
  "position_size_pct": 100.0,
  "max_positions": 2,
  "stop_loss_pct": 5.0,
  "max_holding_days": 0
}
