{
  "name": "R3: RenTech Multi-Factor Concentrated (RSI2+ZScore+Trend)",
  "description": "RenTech-inspired: combine RSI(2) reversal + Z-score extreme + momentum. 100% in best stock, max 2.",
  "symbols": ["NVDA", "TSLA", "MSFT", "AAPL", "META", "GOOGL", "AMZN", "AMD"],
  "indicators": [
    {"type": "sma", "length": 50, "source": "close", "name": "sma_50"},
    {"type": "sma", "length": 200, "source": "close", "name": "sma_200"},
    {"type": "rsi", "length": 2, "source": "close", "name": "rsi_2"},
    {"type": "rsi", "length": 14, "source": "close", "name": "rsi_14"},
    {"type": "zscore", "length": 10, "source": "close", "name": "zscore_10"},
    {"type": "sma", "length": 5, "source": "close", "name": "sma_5"},
    {"type": "external", "symbol": "SPY", "field": "close", "name": "spy_close"},
    {"type": "sma", "length": 200, "source": "spy_close", "name": "spy_sma_200"},
    {"type": "custom", "name": "momentum", "formula": "close / sma_50"}
  ],
  "entry_rule_long": "close > sma_200 & spy_close > spy_sma_200 & rsi_2 < 10 & zscore_10 < -1.0 & rsi_14 > 30",
  "exit_rule": "close > sma_5 | rsi_2 > 90",
  "entry_price_field": "close",
  "ranking_field": "momentum",
  "position_size_mode": "notional_pct",
  "position_size_pct": 100.0,
  "max_positions": 2,
  "stop_loss_pct": 0.0,
  "max_holding_days": 10
}
