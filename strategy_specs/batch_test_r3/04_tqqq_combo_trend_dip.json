{
  "name": "R3: TQQQ Combo (Trend+DipBuy Unified)",
  "description": "Stay in TQQQ when trend is up. Re-enter aggressively on dips. Combined signal.",
  "symbols": ["TQQQ"],
  "indicators": [
    {"type": "external", "symbol": "QQQ", "field": "close", "name": "qqq_close"},
    {"type": "ema", "length": 21, "source": "qqq_close", "name": "qqq_ema_21"},
    {"type": "sma", "length": 50, "source": "qqq_close", "name": "qqq_sma_50"},
    {"type": "sma", "length": 200, "source": "qqq_close", "name": "qqq_sma_200"},
    {"type": "rsi", "length": 2, "source": "close", "name": "rsi_2"},
    {"type": "rsi", "length": 14, "source": "qqq_close", "name": "qqq_rsi_14"},
    {"type": "ema", "length": 21, "source": "close", "name": "ema_21"},
    {"type": "sma", "length": 50, "source": "close", "name": "sma_50"}
  ],
  "entry_rule_long": "qqq_close > qqq_sma_200 & ((qqq_close > qqq_ema_21 & qqq_ema_21 > qqq_sma_50 & close > ema_21) | (rsi_2 < 10 & qqq_rsi_14 > 30))",
  "exit_rule": "close < sma_50 & rsi_2 > 50",
  "entry_price_field": "close",
  "position_size_mode": "notional_pct",
  "position_size_pct": 100.0,
  "max_positions": 1,
  "stop_loss_pct": 0.0,
  "max_holding_days": 0
}
