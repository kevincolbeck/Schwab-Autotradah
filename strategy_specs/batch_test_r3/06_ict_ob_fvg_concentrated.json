{
  "name": "R3: ICT FVG+OB Concentrated 100% (Fixed)",
  "description": "ICT with 100% per position, max 2 stocks. Wider EMA21 exit with 3% buffer.",
  "symbols": ["NVDA", "TSLA", "MSFT", "AAPL", "META", "GOOGL", "AMZN", "AMD"],
  "indicators": [
    {"type": "external", "symbol": "SPY", "field": "close", "name": "spy_close"},
    {"type": "sma", "length": 200, "source": "close", "name": "sma_200"},
    {"type": "sma", "length": 50, "source": "close", "name": "sma_50"},
    {"type": "ema", "length": 21, "source": "close", "name": "ema_21"},
    {"type": "atr", "length": 14, "name": "atr_14"},
    {"type": "sma", "length": 20, "source": "volume", "name": "vol_sma_20"},
    {"type": "sma", "length": 50, "source": "spy_close", "name": "spy_sma_50"},
    {"type": "lag", "source": "high", "periods": 2, "name": "high_2ago"},
    {"type": "lag", "source": "close", "periods": 1, "name": "prev_close"},
    {"type": "lag", "source": "open", "periods": 1, "name": "prev_open"},
    {"type": "lag", "source": "high", "periods": 1, "name": "prev_high"},
    {"type": "custom", "name": "fvg_bull", "formula": "(low > high_2ago) & ((low - high_2ago) / atr_14 >= 0.05)"},
    {"type": "custom", "name": "ob_reclaim", "formula": "(prev_close < prev_open) & (low <= prev_high) & (close >= prev_open)"},
    {"type": "custom", "name": "momentum", "formula": "close / sma_50"}
  ],
  "entry_rule_long": "close > sma_200 & sma_50 > sma_200 & spy_close > spy_sma_50 & volume >= vol_sma_20 * 1.2 & (fvg_bull | ob_reclaim)",
  "exit_rule": "close < ema_21 * 0.97",
  "entry_price_field": "close",
  "ranking_field": "momentum",
  "position_size_mode": "notional_pct",
  "position_size_pct": 100.0,
  "max_positions": 2,
  "stop_loss_pct": 6.0,
  "max_holding_days": 0
}
