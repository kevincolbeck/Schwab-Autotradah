{
  "name": "R3: Connors RSI(2) TQQQ Tight Filter",
  "description": "RSI(2)<5 entry with QQQ above SMA200. Exit on SMA5 recovery. No stop, let mean reversion work.",
  "symbols": ["TQQQ"],
  "indicators": [
    {"type": "external", "symbol": "QQQ", "field": "close", "name": "qqq_close"},
    {"type": "sma", "length": 200, "source": "qqq_close", "name": "qqq_sma_200"},
    {"type": "rsi", "length": 2, "source": "close", "name": "rsi_2"},
    {"type": "sma", "length": 5, "source": "close", "name": "sma_5"},
    {"type": "sma", "length": 200, "source": "close", "name": "sma_200"}
  ],
  "entry_rule_long": "close > sma_200 & qqq_close > qqq_sma_200 & rsi_2 < 5",
  "exit_rule": "close > sma_5",
  "entry_price_field": "close",
  "position_size_mode": "notional_pct",
  "position_size_pct": 100.0,
  "max_positions": 1,
  "stop_loss_pct": 0.0,
  "max_holding_days": 8
}
