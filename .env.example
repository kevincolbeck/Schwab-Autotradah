# Schwab API credentials (from developer.schwab.com)
SCHWAB_CLIENT_ID=your_client_id_here
SCHWAB_CLIENT_SECRET=your_client_secret_here
SCHWAB_REDIRECT_URI=https://127.0.0.1:8182

# Token storage (auto-managed, do not edit manually)
SCHWAB_ACCESS_TOKEN=
SCHWAB_REFRESH_TOKEN=
SCHWAB_TOKEN_EXPIRY=

# Earnings calendar (Finnhub free tier)
FINNHUB_API_KEY=your_finnhub_key_here

# Database paths
SQLITE_DB_PATH=./equities_bot.db
DUCKDB_PATH=./tick_archive.duckdb

# Paper trading
PAPER_ACCOUNT_SIZE=100000
RISK_PER_TRADE_PCT=0.0025
OPTION_STOP_LOSS_PCT=0.30
TARGET_RR=2.5

# Server
PORT=8001
